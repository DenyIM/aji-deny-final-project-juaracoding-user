<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Karyawan Master Automation Suite (SIT v5 - 276 Target TCs - 160 UI + 116 API)" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <!--
        Eksekusi SEKUENSIAL (tanpa parallel="classes") untuk mencegah konflik sesi akun bersama
        hadirsqa1@gmail.com dan menghindari rate-limit/timeout firewall pada api-dev.dikahadir.com.
        Kelas test berikutnya ditambahkan bertahap setelah masing-masing feature branch di-merge ke main:
        - Tester Deny (139 TCs = 84 UI + 55 API):
          UserLoginTest (aktif), RegisterTest, ResetPasswordTest, PermitTest,
          LeaveAndSickTest, DownloadReportTest, UserCrossModuleDenyE2ETest, UserGroupAApiTest
        - Tester Aji (137 TCs = 76 UI + 61 API):
          AttendanceTest, ActivityHistoryTest, CorrectionTest, OvertimeTest,
          UserProfileTest, LeaderStaffTest, UserCrossModuleAjiE2ETest, UserGroupBApiTest
    -->
    <test name="Karyawan Web UI - Autentikasi &amp; Modul Aktif">
        <classes>
            <class name="com.juaracoding.magang.tests.user.deny.UserLoginTest" />
            <class name="com.juaracoding.magang.tests.user.deny.RegisterTest" />
            <class name="com.juaracoding.magang.tests.user.deny.ResetPasswordTest" />
            <class name="com.juaracoding.magang.tests.user.deny.PermitTest" />
            <class name="com.juaracoding.magang.tests.user.deny.LeaveAndSickTest" />
            <class name="com.juaracoding.magang.tests.user.deny.DownloadReportTest" />
            <class name="com.juaracoding.magang.tests.user.deny.UserCrossModuleDenyE2ETest" />
        </classes>
    </test>

</suite>
