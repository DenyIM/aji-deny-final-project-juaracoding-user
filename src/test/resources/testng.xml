<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Karyawan Master Automation Suite (SIT v3 - 195 TCs)" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <!--
        Daftar kelas test Tester Deny (99 TCs) & Tester Aji (96 TCs) akan diaktifkan
        pada Fase 6 setelah masing-masing branch fitur di-merge ke main:
        Tester Deny: UserLoginTest, RegisterTest, ResetPasswordTest, PermitTest,
                     LeaveAndSickTest, DownloadReportTest, UserCrossModuleDenyE2ETest, UserGroupAApiTest
        Tester Aji : AttendanceTest, ActivityHistoryTest, CorrectionTest, OvertimeTest,
                     UserProfileTest, UserCrossModuleAjiE2ETest, UserGroupBApiTest
    -->
    <test name="HADIR Karyawan Master Suite (Fase 3 Foundation Ready)">
        <classes />
    </test>

</suite>
