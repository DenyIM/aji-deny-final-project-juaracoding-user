<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Karyawan Automation Suite - Tester Deny (155 TCs - 84 Web UI + 71 REST API)"
    verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <!--
        Eksekusi SEKUENSIAL khusus Tester Deny (155 TCs = 84 Web UI + 71 REST Assured API).
        Seluruh 7 kelas Web UI + 1 kelas REST Assured API Tester Deny aktif:
        RegisterTest, ResetPasswordTest, PermitTest, LeaveAndSickTest,
        DownloadReportTest, UserCrossModuleDenyE2ETest, UserGroupAApiTest.
    -->
    <test name="Tester Deny - Karyawan Web UI (84 TCs)">
        <classes>
            <class name="com.juaracoding.magang.tests.user.deny.UserLoginTest" />
            <class name="com.juaracoding.magang.tests.user.deny.RegisterTest" />
            <class name="com.juaracoding.magang.tests.user.deny.ResetPasswordTest" />
            <class name="com.juaracoding.magang.tests.user.deny.PermitTest" />
            <class name="com.juaracoding.magang.tests.user.deny.LeaveAndSickTest" />
            <class name="com.juaracoding.magang.tests.user.deny.DownloadReportTest" />
            <class name="com.juaracoding.magang.tests.user.deny.UserCrossModuleDenyE2ETest" />
            <class name="com.juaracoding.magang.api.user.UserGroupAApiTest" />
        </classes>
    </test>

</suite>